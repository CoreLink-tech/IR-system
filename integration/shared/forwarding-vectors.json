      ],
      "header": null,
      "remote": "10.0.0.1",
      "xff": "fe80::1%eth0",
      "clientHeader": null,
      "expected": "10.0.0.1"
    },
    {
      "name": "shorthand dotted address is rejected",
      "trusted": [
        "10.0.0.1"
      ],
      "header": null,
      "remote": "10.0.0.1",
      "xff": "127.1",
      "clientHeader": null,
      "expected": "10.0.0.1"
    },
    {
      "name": "hexadecimal address is rejected",
      "trusted": [
        "10.0.0.1"
      ],
      "header": null,
      "remote": "10.0.0.1",
      "xff": "0x7f.0.0.1",
      "clientHeader": null,
      "expected": "10.0.0.1"
    },
    {
      "name": "duplicate entries",
      "trusted": [
        "10.0.0.1"
      ],
      "header": null,
      "remote": "10.0.0.1",
      "xff": "203.0.113.7, 203.0.113.7",
      "clientHeader": null,
      "expected": "203.0.113.7"
    },
    {
      "name": "exactly 32 entries are read",
      "trusted": [
        "10.0.0.1"
      ],
      "header": null,
      "remote": "10.0.0.1",
      "xff": "198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1",
      "clientHeader": null,
      "expected": "198.51.100.1"
    },
    {
      "name": "33 entries: header not relied on",
      "trusted": [
        "10.0.0.1"
      ],
      "header": null,
      "remote": "10.0.0.1",
      "xff": "198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1, 198.51.100.1",
