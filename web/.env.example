# Local SQLite (dev)
DATABASE_URL=file:./data/ir.db

# Turso (production on Vercel)
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=

JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING_64_CHARS
API_KEY_HASH_PEPPER=CHANGE_ME_RANDOM_PEPPER
API_KEY_PREFIX=IRS_

# Optional two-step
REQUIRE_2FA=false
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Security Dashboard

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
