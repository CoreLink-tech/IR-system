NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

DATABASE_URL="mysql://ir_user:CHANGE_ME@localhost:3306/shop"

# Generate real values for the four secrets below with: npm run gen:secrets
# The server refuses to start while any of them still holds a placeholder.
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

API_KEY_PREFIX=IRS_
API_KEY_HASH_PEPPER=CHANGE_ME_RANDOM_PEPPER

# The dashboard's exact origin(s), comma separated. No wildcards. Also used to check the Origin
# header on cookie-based refresh and logout.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# The refresh cookie is marked Secure when NODE_ENV=production. Set false ONLY for plain-http
# local testing of a production-mode build; set true to force it elsewhere.
# COOKIE_SECURE=

# Reverse proxies whose X-Forwarded-For header is believed: addresses, CIDR blocks, or the word private.
# Empty (the default) means forwarding headers are ignored and the connection address is used.
TRUSTED_PROXIES=
# Optional header the proxy sets to the client address, for example CF-Connecting-IP. Only used behind a trusted proxy.
CLIENT_IP_HEADER=
THROTTLE_TTL=60
# Requests per minute, counted per route. Administrators and anonymous callers are counted
# per address; the website is counted per API key and needs a much larger allowance.
THROTTLE_LIMIT=120
THROTTLE_KEY_LIMIT=6000
THROTTLE_LOGIN_LIMIT=20

RISK_LEVEL_SUSPICIOUS=30
RISK_LEVEL_HIGH=60
RISK_LEVEL_CRITICAL=80

# IP intelligence. Comma separated, in priority order. Use "none" to disable.
# Available: tor (free, no key), ipapi (free tier, no key), ipinfo (IPINFO_TOKEN),
# abuseipdb (ABUSEIPDB_API_KEY). Recommended starting point: tor,ipapi
IP_INTEL_PROVIDERS=tor,ipapi
IP_INTEL_TIMEOUT_MS=3000
IP_INTEL_CACHE_HOURS=24
IP_API_KEY=
IPINFO_TOKEN=
ABUSEIPDB_API_KEY=
ABUSEIPDB_MALICIOUS_THRESHOLD=75

AUTO_BLOCK_ENABLED=true
AUTO_BLOCK_TTL_MINUTES=60
AUTO_BLOCK_MIN_RISK=85

BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_AT_LEAST_12_CHARS
BOOTSTRAP_ADMIN_NAME=Initial Admin

# --- Retention (see docs/DATABASE.md). Run "npm run cleanup" on a schedule. 0 keeps that table forever.
# Events attached to an unresolved incident are never removed, whatever these say.
RETENTION_EVENT_DAYS=90
RETENTION_INGEST_AUDIT_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_INCIDENT_DAYS=730
RETENTION_BLOCK_HISTORY_DAYS=365
RETENTION_TOKEN_GRACE_DAYS=7
RETENTION_EXPIRED_ENTRY_DAYS=7
RETENTION_BATCH_SIZE=5000
RETENTION_PAUSE_MS=200
RETENTION_MAX_SECONDS=600

# --- Password policy (see docs/SECURITY.md). Passwords must be 12 to 128 characters and are checked against a built-in
# list of common passwords. To block more, point this at a text file with one password (or word) per line.
PASSWORD_BLOCKLIST_FILE=

# --- Sign-in lockout (see docs/SECURITY.md). After LOCKOUT_THRESHOLD wrong attempts for one email address, that address
# is locked for LOCKOUT_BASE_SECONDS, doubling with each further wrong attempt up to LOCKOUT_MAX_SECONDS. A lock always
# ends by itself. Networks listed here are never locked out (for example the office VPN): list only networks you trust.
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=900
LOCKOUT_RESET_MINUTES=60
LOCKOUT_EXEMPT_NETWORKS=
