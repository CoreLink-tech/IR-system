NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

DATABASE_URL="mysql://pishon_user:CHANGE_ME@localhost:3306/pishon_market"

# Generate real values for the four secrets below with: npm run gen:secrets
# The server refuses to start while any of them still holds a placeholder.
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

API_KEY_PREFIX=PMS_
API_KEY_HASH_PEPPER=CHANGE_ME_RANDOM_PEPPER

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

THROTTLE_TTL=60
THROTTLE_LIMIT=120

RISK_LEVEL_SUSPICIOUS=30
RISK_LEVEL_HIGH=60
RISK_LEVEL_CRITICAL=80

# IP intelligence. Comma separated, in priority order. Use "none" to disable.
# Available: tor (free, no key), ipapi (free tier, no key), ipinfo (IPINFO_TOKEN),
# abuseipdb (ABUSEIPDB_API_KEY). Recommended starting point: tor,ipapi
IP_INTEL_PROVIDERS=tor,ipapi
IP_INTEL_TIMEOUT_MS=3000
IP_INTEL_CACHE_HOURS=24
IP_API_KEY=
IPINFO_TOKEN=
ABUSEIPDB_API_KEY=
ABUSEIPDB_MALICIOUS_THRESHOLD=75

AUTO_BLOCK_ENABLED=true
AUTO_BLOCK_TTL_MINUTES=60
AUTO_BLOCK_MIN_RISK=85

BOOTSTRAP_ADMIN_EMAIL=admin@pishon.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_AT_LEAST_12_CHARS
BOOTSTRAP_ADMIN_NAME=Initial Admin
