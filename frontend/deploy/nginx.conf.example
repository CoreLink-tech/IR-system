# Example nginx server block for the Pishon Security dashboard (static files only).
#
# 1. Build:   cd frontend && npm ci && npm run build        (output: frontend/dist)
# 2. Copy dist/ to /var/www/pishon-dashboard/
# 3. Edit /var/www/pishon-dashboard/config.json: set "apiBaseUrl" to your API's origin.
# 4. Put security-headers.conf next to this file (or in /etc/nginx/snippets/), set the same API
#    origin in its connect-src, and set the API's CORS_ORIGINS to this site's exact origin.
# 5. Replace the domain and certificate paths below, then:  nginx -t && systemctl reload nginx
#
# The dashboard and the API may be on different hostnames (cookies are SameSite=Strict, so they
# must be on the same SITE: for example dashboard.example.com and api.example.com).

# TLS-BEGIN
server {
  listen 80;
  server_name dashboard.example.com;
  return 301 https://$host$request_uri;
}
# TLS-END

server {
  # TLS-BEGIN
  listen 443 ssl http2;
  ssl_certificate     /etc/letsencrypt/live/dashboard.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/dashboard.example.com/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  # TLS-END
  server_name dashboard.example.com;

  root /var/www/pishon-dashboard;
  index index.html;
  server_tokens off;
  autoindex off;
  charset utf-8;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  gzip_min_length 512;

  include security-headers.conf;

  # Built files have a hash in their name, so they can be cached for a year.
  location /assets/ {
    include security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;            # a missing asset is a 404, never the app's HTML page
  }

  # Settings the page reads when it starts. Never cached, so a change takes effect at once.
  location = /config.json {
    include security-headers.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri =404;
  }

  location = /favicon.svg {
    include security-headers.conf;
    add_header Cache-Control "public, max-age=86400" always;
    try_files $uri =404;
  }

  # Everything else is a page of the app. Unknown paths get index.html so links and reloads work
  # (the router shows its own "not found" page).
  location / {
    include security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri /index.html;
  }

  # Never serve source maps, dotfiles or the like.
  location ~ /\. { deny all; }
  location ~ \.map$ { return 404; }
}
